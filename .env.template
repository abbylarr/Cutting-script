# Database Configuration
DATABASE_URL=sqlite:///./filmlist.db

# Redis Configuration (optional — in-memory fallback if unavailable)
REDIS_URL=redis://localhost:6379

# External API Keys (optional — leave empty for autonomous offline mode)
OPENAI_API_KEY=
HF_TOKEN=

# File Storage Paths
UPLOAD_DIR=uploads
OUTPUT_DIR=output

# Security
SECRET_KEY=your-secret-key-change-in-production-minimum-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Processing Configuration
RATE_PER_MINUTE=75.0
MIN_SCENE_LENGTH=2.0
MAX_FILE_SIZE=5368709120

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Filmlist

# Autonomous mode: free balance, skip billing, prefer offline fallbacks
DEBUG=true
AUTONOMOUS_MODE=true
SKIP_BILLING=true
INITIAL_USER_BALANCE=10000
